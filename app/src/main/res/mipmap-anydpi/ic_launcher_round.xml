<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant of the adaptive launcher icon. Launchers that ask for a round icon
  get the same three layers; the system applies the circular mask, so the artwork
  is unchanged rather than a second hand-made raster.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/faceit_launcher_background"/>
    <foreground android:drawable="@drawable/faceit_launcher_foreground"/>
    <monochrome android:drawable="@drawable/faceit_launcher_monochrome"/>
</adaptive-icon>
