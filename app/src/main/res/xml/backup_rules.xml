<?xml version="1.0" encoding="utf-8"?>
<!--
  Face It stores the saved environment, Private Vault records and imported
  artwork in app-private storage. None of it may travel to a cloud backup or to a
  new device without the user explicitly exporting it, so every domain is
  excluded and nothing is included.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
